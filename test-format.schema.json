{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAT Studio test format v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "title",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "demo": {
      "type": "boolean"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "alt",
          "data"
        ],
        "properties": {
          "alt": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=\\s]+$"
          }
        }
      }
    },
    "testType": {
      "enum": [
        "sectional",
        "full"
      ]
    },
    "sourceAnalysis": {
      "type": "object",
      "required": [
        "label",
        "sourceImages",
        "questionResults"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sourceImages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "reportedScore": {
          "type": "number"
        },
        "questionResults": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "questionId",
              "outcome",
              "timeSeconds"
            ],
            "properties": {
              "questionId": {
                "$ref": "#/$defs/id"
              },
              "outcome": {
                "enum": [
                  "Correct",
                  "Incorrect",
                  "Unanswered"
                ]
              },
              "timeSeconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "percentileMapper": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "percentile",
              "score",
              "section"
            ],
            "properties": {
              "percentile": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "score": {
                "type": "number"
              },
              "section": {
                "enum": [
                  "VARC",
                  "DILR",
                  "QA"
                ]
              }
            }
          }
        },
        "reportedAreas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "toString",
          "toLocaleString",
          "valueOf",
          "hasOwnProperty",
          "isPrototypeOf",
          "propertyIsEnumerable"
        ]
      }
    },
    "assetIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "section": {
      "type": "object",
      "required": [
        "code",
        "groups"
      ],
      "properties": {
        "code": {
          "enum": [
            "VARC",
            "DILR",
            "QA"
          ]
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "title",
        "questions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "stimulus": {
          "type": "string"
        },
        "assetIds": {
          "$ref": "#/$defs/assetIds"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "type",
        "prompt",
        "answer"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "MCQ",
            "TITA"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "assetIds": {
          "$ref": "#/$defs/assetIds"
        },
        "sourceImages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceNumber": {
          "type": "integer",
          "minimum": 1
        },
        "area": {
          "type": "string"
        },
        "selectionCategory": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "benchmark": {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "sourceImage": {
              "type": "string"
            },
            "topperTimeSeconds": {
              "type": "number",
              "minimum": 0
            },
            "topperAttemptPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "topperAccuracyPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "topperPValue": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "MCQ"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "answer": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "TITA"
              }
            }
          },
          "then": {
            "properties": {
              "answer": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                }
              }
            }
          }
        }
      ]
    }
  },
  "$comment": "Runtime validation additionally requires unique section codes, unique group/question IDs across the test, option IDs unique within each question, answer membership in options, and existing asset references. Timing and marking rules are fixed by the app.",
  "allOf": [
    {
      "if": {
        "required": [
          "testType"
        ],
        "properties": {
          "testType": {
            "const": "sectional"
          }
        }
      },
      "then": {
        "properties": {
          "sections": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "testType"
        ],
        "properties": {
          "testType": {
            "const": "full"
          }
        }
      },
      "then": {
        "properties": {
          "sections": {
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    }
  ]
}
